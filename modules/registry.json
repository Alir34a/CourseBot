  {
   "name": "config",
   "path": "modules/config",
   "purpose": "Env-based configuration, no hard-coded secrets; validates owner/admin settings at startup.",
   "interface": [
    "load_config(env=None)->Config",
    "is_owner_configured(cfg)->dict",
    "require_config(cfg)"
   ],
   "provides": [
    "load_config(env=None)->Config",
    "is_owner_configured(cfg)->dict",
    "require_config(cfg)"
   ],
   "dependencies": [],
   "standalone": true,
   "reusable": true,
   "configuration": "BOT_TOKEN, ADMIN_IDS, ADMIN_USERNAMES, OWNER_EMAIL, DATABASE_PATH, DATABASE_URL, COURSE_SLUG, COURSE_TITLE, EPISODE_COUNT, OFFER_TRIGGER, OFFER_URL, SALES_WEBHOOK_SECRET, ADMIN_*",

# ===== Bot configuration (COPY to .env, never commit .env) =====
# Telegram bot token from @BotFather.
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
# Owner/manager Telegram numeric IDs (comma-separated). Only these IDs can use /admin.
ADMIN_IDS=123456789
ADMIN_USERNAMES=your_admin_username
# Owner contact (shown in reports / used for notifications).
OWNER_EMAIL=owner@example.com
# Database (sqlite file; recreated automatically if missing).
DATABASE_PATH=data/bot.db
DATABASE_URL=
# Initial course seed (used on first run only; afterwards courses are managed via /admin in Telegram).
COURSE_SLUG=sample-course
COURSE_TITLE=Sample course
EPISODE_COUNT=15
# Default offer link for the seed offer (editable later via /admin).
OFFER_TRIGGER=episode:15
OFFER_URL=https://example.com/buy
SALES_WEBHOOK_SECRET=CHANGE_ME
# Environment
ENV=development
LOG_LEVEL=INFO
